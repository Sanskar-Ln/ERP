// Prisma schema — jewellery ERP data model.
//
// SYSTEM-WIDE RULES ENCODED HERE:
// 1. Every primary key is `String @id` with NO database default: UUIDs are
//    minted in the application (shared `newId()`), never by the DB. This is
//    deliberate — it enables future offline clients to create rows locally.
// 2. Every tenant-scoped model has `tenantId` (enforced additionally by the
//    tenant-scoped Prisma client in src/platform/tenancy).
// 3. Money columns are BigInt PAISE. Weight columns are Decimal grams
//    (3 dp) or Decimal carats (3 dp). No floats.
// 4. Financial rows (Document*, StockMovement, OldGoldExchange) are
//    append-only: no updatedAt, corrections happen via supersede/reversal
//    rows, and every financial mutation writes an AuditLog row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------- enums

enum Role {
  ADMIN
  OPS
}

enum ComponentType {
  METAL
  STONE
  MAKING
  ITEM
}

enum MaterialForm {
  JEWELLERY
  BULLION
  LOOSE_ROUGH
  LOOSE_POLISHED
  IMITATION
  SERVICE
}

enum DocType {
  TAX_INVOICE
  ESTIMATE
  DELIVERY_CHALLAN
}

enum DocStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  CANCELLED
  CONVERTED
}

enum GstSplit {
  INTRA_STATE
  INTER_STATE
}

enum TaxKind {
  CGST
  SGST
  IGST
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  EXCHANGE_IN
  KARIGAR_ISSUE
  KARIGAR_RECEIPT
  RESERVE
  UNRESERVE
  REVERSAL
}

enum CertificateLab {
  IGI
  GIA
  SGL
  OTHER
}

enum BarcodeSymbology {
  CODE128
  DATAMATRIX
}

enum MakingChargeType {
  FLAT
  PER_GRAM
  PERCENT_OF_METAL
}

enum RateSource {
  FEED
  MANUAL_FIX
}

enum TransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  SOLD
  IN_TRANSIT
  WITH_KARIGAR
  SCRAPPED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum TagShape {
  RECTANGLE
  DUMBBELL
}

enum PrinterLanguage {
  ZPL
  TSPL
  HTML
  AUTO
}

enum PrinterConnection {
  BROWSER
  DOWNLOAD
  NETWORK
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

// ------------------------------------------------------------- platform

model Tenant {
  id        String   @id
  name      String
  gstin     String?
  stateCode String // 2-digit GST state code of the registered office
  /** max total discount an OPS user may give, bps of subtotal (200 = 2%); ADMIN unrestricted */
  opsMaxDiscountBps Int @default(200)
  createdAt DateTime @default(now())

  branches Branch[]
  users    User[]
}

model Branch {
  id        String  @id
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  code      String // short branch code, e.g. "HQ", "MUM1"
  name      String
  stateCode String // branch state drives CGST/SGST vs IGST on its invoices
  gstin     String?
  address   String?

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id           String  @id
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  email        String
  name         String
  passwordHash String
  role         Role
  branchId     String?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Append-only audit trail. One row per (financial) mutation: who did what
// to which entity, with before/after JSON snapshots for forensics.
model AuditLog {
  id          String   @id
  tenantId    String
  actorUserId String?
  entity      String // model name, e.g. "Document"
  entityId    String
  action      String // e.g. "ISSUE", "CANCEL", "CONVERT", "RATE_FIX"
  before      Json?
  after       Json?
  at          DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

// ------------------------------------------------------------- master data

model Metal {
  id       String @id
  tenantId String
  code     String // GOLD | SILVER | PLATINUM
  name     String

  purities Purity[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// A tradable purity of a metal. finenessPpt (parts per thousand) is the
// number pricing math uses; karat/label are display.
model Purity {
  id          String @id
  tenantId    String
  metalId     String
  metal       Metal  @relation(fields: [metalId], references: [id])
  label       String // "22K", "18K", "925"
  karat       Int?
  finenessPpt Int // 916, 750, 925 …

  @@unique([tenantId, metalId, label])
  @@index([tenantId])
}

model StoneType {
  id        String  @id
  tenantId  String
  code      String // DIAMOND, RUBY, EMERALD …
  name      String
  isDiamond Boolean // diamonds carry 4C attributes on components

  @@unique([tenantId, code])
  @@index([tenantId])
}

model HsnCode {
  id          String @id
  tenantId    String
  code        String // 4–8 digit HSN / SAC
  description String

  taxRules TaxRule[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// One row of the configurable tax matrix. Resolution key:
// (componentType, form, isSetInJewellery, invoiceMode) + effective dating.
// BUSINESS RULE: GST rates are tenant DATA (seeded with 2026 India defaults),
// never hardcoded in the engine.
model TaxRule {
  id               String        @id
  tenantId         String
  componentType    ComponentType
  form             MaterialForm
  isSetInJewellery Boolean
  invoiceMode      DocType
  hsnCodeId        String?
  hsnCode          HsnCode?      @relation(fields: [hsnCodeId], references: [id])
  rateBps          Int // 300 = 3%, 25 = 0.25%
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  note             String?

  @@index([tenantId, componentType, form, isSetInJewellery, invoiceMode])
}

model Customer {
  id          String  @id
  tenantId    String
  name        String
  phone       String
  email       String?
  addressLine String?
  city        String?
  stateCode   String // place-of-supply default for this customer
  pincode     String?
  gstin       String?
  pan         String?
  kycDocs     Json    @default("[]") // [{docType, docNumber}] — see zKycDoc
  /** customer-specific rate adjustment on the board rate, SIGNED bps (−100 = 1% concession) */
  rateAdjustBps Int   @default(0)
  createdAt   DateTime @default(now())

  paperBills PaperBill[]

  @@index([tenantId, phone])
  @@index([tenantId, name])
}

// Scanned/photographed PAPER bills attached to a customer — the shop's
// old handwritten/printed bills digitized. A customer accumulates many of
// these over time (recurring customers), alongside their system-issued
// Documents. Rows are append-only (no update/delete endpoints); the file
// itself lives on disk under UPLOAD_DIR, referenced by storagePath.
model PaperBill {
  id               String   @id
  tenantId         String
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  fileName         String // original name as uploaded, display only
  mimeType         String // image/jpeg | image/png | image/webp | application/pdf
  sizeBytes        Int
  storagePath      String // server-side file name under UPLOAD_DIR (uuid + ext)
  note             String? // e.g. "old bill 2019, gold chain repair"
  billDate         DateTime? // date written on the paper bill, if known
  // OCR extraction result: { text, fields: { billNo?, billDate?, totalPaise?,
  // amountsPaise[], weightsG[], ratePaisePer10g?, phones[] } } — best-effort
  // reading of the paper bill to help staff key in the online bill faster.
  extracted        Json?
  extractedAt      DateTime?
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  @@index([tenantId, customerId, uploadedAt(sort: Desc)])
}

model Supplier {
  id          String  @id
  tenantId    String
  name        String
  phone       String?
  gstin       String?
  stateCode   String
  addressLine String?

  @@index([tenantId])
}

// Karigar = artisan/goldsmith who receives metal and returns finished goods.
model Karigar {
  id        String  @id
  tenantId  String
  name      String
  phone     String?
  specialty String?

  @@index([tenantId])
}

// Metal rate rows are append-only: a new FEED tick or MANUAL_FIX row is
// inserted; billing always reads the latest effective row ≤ now.
// Rate convention: paise per 10 grams at the given purity (Indian bourse).
model MetalRate {
  id              String     @id
  tenantId        String
  metalId         String
  purityId        String
  ratePaisePer10g BigInt
  source          RateSource
  effectiveAt     DateTime
  note            String?
  createdByUserId String?
  createdAt       DateTime   @default(now())

  @@index([tenantId, metalId, purityId, effectiveAt(sort: Desc)])
}

// ------------------------------------------------------------- inventory

// Composite inventory item: metal component(s) + stone component(s) + a
// making-charge rule. Dual-unit: pieces AND weights are both first-class.
model Item {
  id                String           @id
  tenantId          String
  itemCode          String // stable code — THIS is what barcodes encode
  name              String
  description       String?
  category          String? // e.g. "Ring", "Chain" — free-text classification
  subCategory       String?
  branchId          String
  lotId             String?
  lot               Lot?             @relation(fields: [lotId], references: [id])
  hsnCodeId         String
  pieces            Int              @default(1)
  makingChargeType  MakingChargeType
  makingChargeValue BigInt // FLAT: paise/pc, PER_GRAM: paise/g, PERCENT: bps
  // flat per-piece charges that ride the making/service GST path at sale
  hallmarkChargePaise BigInt @default(0)
  packingChargePaise  BigInt @default(0)
  otherChargePaise    BigInt @default(0)
  // BIS hallmark metadata (informational; the charge above is what bills)
  hallmarkNo        String?
  hallmarkAgency    String?
  isStudded         Boolean          @default(false) // → composite 3% GST path
  isPrecious        Boolean          @default(true) // false → imitation (18%)
  status            ItemStatus       @default(IN_STOCK)
  createdAt         DateTime         @default(now())

  metalComponents ItemMetalComponent[]
  stoneComponents ItemStoneComponent[]
  tags            Tag[]

  @@unique([tenantId, itemCode])
  @@index([tenantId, branchId, status])
}

model ItemMetalComponent {
  id           String  @id
  tenantId     String
  itemId       String
  item         Item    @relation(fields: [itemId], references: [id])
  metalId      String
  purityId     String
  grossWeightG Decimal @db.Decimal(12, 3)
  netWeightG   Decimal @db.Decimal(12, 3)
  wastageBps   Int     @default(0) // billed wastage allowance (800 = 8%)

  @@index([tenantId, itemId])
}

model ItemStoneComponent {
  id                String          @id
  tenantId          String
  itemId            String
  item              Item            @relation(fields: [itemId], references: [id])
  stoneTypeId       String
  pieces            Int
  weightCt          Decimal         @db.Decimal(10, 3)
  weightRatti       Decimal?        @db.Decimal(10, 2)
  cut               String? // 4C — diamonds only
  color             String?
  clarity           String?
  certLab           CertificateLab?
  certNo            String?
  ratePaisePerCarat BigInt?
  valuePaise        BigInt // stone value used in pricing

  @@index([tenantId, itemId])
}

model Lot {
  id         String   @id
  tenantId   String
  lotNo      String
  supplierId String?
  karigarId  String?
  /** set when this lot was created by receiving a purchase order */
  purchaseOrderId String? @unique
  receivedAt DateTime
  note       String?

  items Item[]

  @@unique([tenantId, lotNo])
  @@index([tenantId])
}

// ------------------------------------------------------------- procurement

// Supplier → PO → goods receipt (weight-verified) → Lot → inventory intake.
// The PO freezes the agreed lines; receipt records verified weights.
model PurchaseOrder {
  id              String              @id
  tenantId        String
  poNumber        String
  supplierId      String
  branchId        String
  status          PurchaseOrderStatus @default(DRAFT)
  expectedAt      DateTime?
  orderedAt       DateTime?
  receivedAt      DateTime?
  note            String?
  totalValuePaise BigInt              @default(0)
  createdByUserId String?
  createdAt       DateTime            @default(now())

  lines            PurchaseOrderLine[]
  supplierPayments SupplierPayment[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

model PurchaseOrderLine {
  id              String        @id
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  lineNo          Int
  description     String
  category        String?
  pieces          Int
  expectedWeightG Decimal?      @db.Decimal(12, 3)
  /** verified at goods receipt */
  receivedWeightG Decimal?      @db.Decimal(12, 3)
  purityId        String?
  ratePaisePer10g BigInt?
  valuePaise      BigInt

  @@unique([purchaseOrderId, lineNo])
  @@index([tenantId])
}

// Money paid TO the supplier against a PO. Append-only, like Payment.
model SupplierPayment {
  id              String        @id
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  mode            PaymentMode
  amountPaise     BigInt
  reference       String?
  note            String?
  paidAt          DateTime      @default(now())
  createdByUserId String?
  createdAt       DateTime      @default(now())

  @@index([tenantId, purchaseOrderId])
}

// ------------------------------------------------------------- orders

// Customer-order pipeline (workflow object, NOT a financial document):
// DRAFT→CONFIRMED→PROCESSING→READY→DELIVERED→COMPLETED, CANCELLED from any
// pre-DELIVERED state. Confirming reserves stock lines; cancelling releases
// them; billing links via documentId (money stays on Documents).
model Order {
  id              String      @id
  tenantId        String
  orderNumber     String
  customerId      String
  branchId        String
  status          OrderStatus @default(DRAFT)
  note            String?
  /** the estimate/invoice this order was billed as (set on/before DELIVERED) */
  documentId      String?
  cancelReason    String?
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines OrderLine[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model OrderLine {
  id              String   @id
  tenantId        String
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  lineNo          Int
  /** stock item (reserved on CONFIRMED) — null for made-to-order lines */
  itemId          String?
  description     String
  pieces          Int      @default(1)
  expectedWeightG Decimal? @db.Decimal(12, 3)

  @@unique([orderId, lineNo])
  @@index([tenantId])
}

// APPEND-ONLY stock ledger. Rows are never updated or deleted; a mistake is
// corrected by inserting a REVERSAL row with reversesId → original.
model StockMovement {
  id            String       @id
  tenantId      String
  itemId        String
  movementType  MovementType
  branchId      String
  pieces        Int // signed: +in / −out
  grossWeightG  Decimal      @db.Decimal(12, 3) // signed like pieces
  refDocumentId String? // billing document that caused this
  reversesId    String?      @unique // original movement being reversed
  note          String?
  actorUserId   String?
  at            DateTime     @default(now())

  @@index([tenantId, itemId, at])
  @@index([tenantId, branchId, at])
}

model BranchTransfer {
  id              String         @id
  tenantId        String
  fromBranchId    String
  toBranchId      String
  status          TransferStatus @default(IN_TRANSIT)
  note            String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  receivedAt      DateTime?

  items BranchTransferItem[]

  @@index([tenantId, status])
}

model BranchTransferItem {
  id         String         @id
  tenantId   String
  transferId String
  transfer   BranchTransfer @relation(fields: [transferId], references: [id])
  itemId     String

  @@index([tenantId, transferId])
}

// ------------------------------------------------------------- tagging

// One tag per physical piece. BUSINESS RULE: barcode payload = tagCode,
// which embeds only the stable item code + piece ordinal — never price —
// so daily repricing NEVER requires reprinting.
model Tag {
  id        String           @id
  tenantId  String
  itemId    String
  item      Item             @relation(fields: [itemId], references: [id])
  tagCode   String // e.g. "RING-0001#1"
  symbology BarcodeSymbology @default(CODE128)
  isActive  Boolean          @default(true)
  printedAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([tenantId, tagCode])
  @@index([tenantId, itemId])
}

// A named PHYSICAL label layout, described in millimetres and deliberately
// device-independent: which printer language renders it (ZPL/TSPL/HTML) is
// chosen at print time from the Printer profile, so a template outlives any
// particular piece of hardware. DUMBBELL is the jewellery butterfly tag —
// two printable flags joined by a neck that wraps the ring shank or chain.
model LabelTemplate {
  id          String           @id
  tenantId    String
  name        String
  shape       TagShape         @default(RECTANGLE)
  widthMm     Decimal          @db.Decimal(6, 2)
  heightMm    Decimal          @db.Decimal(6, 2)
  /** dumbbell only — leftFlag + neck + rightFlag must equal widthMm */
  leftFlagMm  Decimal?         @db.Decimal(6, 2)
  neckMm      Decimal?         @db.Decimal(6, 2)
  rightFlagMm Decimal?         @db.Decimal(6, 2)
  symbology   BarcodeSymbology @default(CODE128)
  fields      Json // [{ field, region, fontPt }] — see zCreateLabelTemplate
  isDefault   Boolean          @default(false)

  @@unique([tenantId, name])
}

// A printer the shop can send label jobs to. `language: AUTO` means the
// hardware has not been identified yet — POST /printers/:id/identify probes
// the device and resolves it, so a printer can be registered before anyone
// knows its brand.
model Printer {
  id            String            @id
  tenantId      String
  name          String
  connection    PrinterConnection @default(BROWSER)
  language      PrinterLanguage   @default(AUTO)
  host          String? // required for NETWORK
  port          Int               @default(9100)
  dpi           Int               @default(203)
  isDefault     Boolean           @default(false)
  /** model string reported by the printer at the last successful identify */
  detectedModel String?
  lastSeenAt    DateTime?
  createdAt     DateTime          @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LabelBatch {
  id              String   @id
  tenantId        String
  templateId      String
  tagIds          Json // snapshot of tag ids rendered in this batch
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ------------------------------------------------------------- billing

// Human-facing document numbering (INV-2026-000123). Identity stays UUID;
// this is ONLY a per-tenant, per-series display counter, incremented inside
// the issue transaction (SELECT … FOR UPDATE semantics via updateMany guard).
model NumberSeries {
  id         String @id
  tenantId   String
  seriesCode String // e.g. "INV-2026", "EST-2026", "DC-2026"
  nextNumber Int    @default(1)

  @@unique([tenantId, seriesCode])
}

// IMMUTABLE financial document (Tax Invoice / Estimate / Delivery Challan).
// Never updated after ISSUED except status transitions to SUPERSEDED /
// CANCELLED / CONVERTED (the financial content never changes; each
// transition writes an AuditLog row and, where applicable, a successor
// document linked via convertedFromId / supersedesId).
model Document {
  id                      String    @id
  tenantId                String
  docType                 DocType
  docNumber               String
  status                  DocStatus @default(ISSUED)
  branchId                String
  customerId              String
  issuedAt                DateTime  @default(now())
  sellerStateCode         String // branch state at issue time (snapshot)
  placeOfSupplyStateCode  String
  gstSplit                GstSplit
  subtotalPaise           BigInt // sum of line gross values before discounts
  discountPaise           BigInt // cart-level discount prorated in lines
  exchangeValuePaise      BigInt // old-gold value credited (GST on addition only)
  taxableValuePaise       BigInt
  totalTaxPaise           BigInt
  grandTotalPaise         BigInt
  note                    String?
  cancelReason            String?
  convertedFromId         String?   @unique // estimate this invoice came from
  supersedesId            String?   @unique // document this one corrects
  createdByUserId         String?

  lines     DocumentLine[]
  taxLines  DocumentTaxLine[]
  exchanges OldGoldExchange[]
  payments  Payment[]

  @@unique([tenantId, docType, docNumber])
  @@index([tenantId, customerId, issuedAt])
  @@index([tenantId, docType, issuedAt])
}

// Money received (or returned) against a document. APPEND-ONLY: rows are
// never updated or deleted — a wrong payment is corrected by a REFUND row.
// Settlement status (UNPAID/PARTIALLY_PAID/PAID/REFUNDED) is always DERIVED
// from the rows + the document's grand total, never stored.
model Payment {
  id              String      @id
  tenantId        String
  documentId      String
  document        Document    @relation(fields: [documentId], references: [id])
  kind            PaymentKind @default(PAYMENT)
  mode            PaymentMode
  amountPaise     BigInt // always positive; kind carries the direction
  reference       String? // UTR / txn id / cheque number
  note            String?
  paidAt          DateTime    @default(now())
  createdByUserId String?
  createdAt       DateTime    @default(now())

  @@index([tenantId, documentId])
  @@index([tenantId, paidAt])
}

// One sold line. `snapshot` freezes every pricing input (weights, rates,
// wastage, making rule) at issue time so the document stays reproducible
// even after masters change — part of the immutability guarantee.
model DocumentLine {
  id                  String   @id
  tenantId            String
  documentId          String
  document            Document @relation(fields: [documentId], references: [id])
  lineNo              Int
  itemId              String?
  description         String
  hsnCode             String // snapshot of HSN at issue time
  pieces              Int
  metalValuePaise     BigInt
  stoneValuePaise     BigInt
  makingPaise         BigInt
  extraChargesPaise   BigInt   @default(0) // hallmark + packing + other, frozen at issue
  makingDiscountPaise BigInt
  lineDiscountPaise   BigInt // prorated cart discount + line's own discount
  grossPaise          BigInt // metal + stone + making + extra charges − discounts
  taxablePaise        BigInt
  snapshot            Json?

  @@unique([documentId, lineNo])
  @@index([tenantId, documentId])
}

// One row per (kind, rate) bucket, e.g. CGST 1.5% / SGST 1.5% / IGST 3%.
model DocumentTaxLine {
  id           String   @id
  tenantId     String
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  kind         TaxKind
  label        String // "CGST 1.5%"
  rateBps      Int
  taxablePaise BigInt
  taxPaise     BigInt

  @@index([tenantId, documentId])
}

// Old-gold tendered against a purchase. BUSINESS RULE: GST is charged on the
// value addition only (new value − exchange value); the exchange row keeps
// the assessed weight/purity/rate for audit.
model OldGoldExchange {
  id              String   @id
  tenantId        String
  documentId      String
  document        Document @relation(fields: [documentId], references: [id])
  metalId         String
  purityId        String
  grossWeightG    Decimal  @db.Decimal(12, 3)
  netWeightG      Decimal  @db.Decimal(12, 3)
  ratePaisePer10g BigInt
  valuePaise      BigInt // netWeight × rate — credited to the customer
  note            String?
  createdAt       DateTime @default(now())

  @@index([tenantId, documentId])
}
